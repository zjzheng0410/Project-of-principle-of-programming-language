match None {
    None => 0
    Some(unused_value) => unused_value
}
// => 0

first_above(candidates, threshold) {
    for_each(candidate in candidates) {
        if (candidate > threshold) {
            return Some(candidate)
        }
    }
    None
}

first_above([2, 4, 9, 7], 6)
// => Some(9)
first_above([2, 4, 5], 6) // => None

map([4, 1, 3], fn n => n + 2)
// => [6, 3, 5]
filter([], fn n => n > 0) // => []
reduce([], 100, fn acc, n => acc + n)
// => 100

make_stepper(seed) {
    let current = seed
    fn(delta) {
        current = current + delta
        current
    }
}

let left_step = make_stepper(4)
let right_step = make_stepper(10)
left_step(2)
// => 6
right_step(1)
// => 11
left_step(1)
// => 7

match Some(None) {
    Some(inner) => match inner {
        None => 42
        Some(value) => value
    }
    None => -1
}
// => 42

let mark = 12
match Some(mark) {
    Some(points) if points > 10 => 1
    Some(points) => 0
    None => -1
} // => 1

{
    let inner_total = 30
    inner_total + 5
    // => 35
}
