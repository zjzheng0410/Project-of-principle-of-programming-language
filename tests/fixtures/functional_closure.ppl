let double = fn(x) {
    x * 2
}
double(10) // => 20

let add = fn(a) {
    fn(b) {
        a + b
    }
}
add(3)(4) // => 7

let add_lambda = fn a => fn b => a + b
add_lambda(5)(6) // => 11

let base = 100
let add_base = fn(x) {
    base + x
}
add_base(23) // => 123

let make_counter = fn(start) {
    let n = start
    fn() {
        n = n + 1
        n
    }
}
let c1 = make_counter(0)
let c2 = make_counter(10)
c1() // => 1
c1() // => 2
c2() // => 11
c1() // => 3
