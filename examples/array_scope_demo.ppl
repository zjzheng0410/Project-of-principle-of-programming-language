// 数组处理和词法作用域
len([]) // => 0
[1, 2, 3][2] // => 3
map([1, 2, 3], fn x => x + 10) // => [11, 12, 13]
filter([1, 3, 5, 2, 4], fn x => x > 3) // => [5, 4]
reduce([1, 2, 3, 4], 0, fn acc, x => acc + x) // => 10
any([1, 2, 3], fn x => x == 2) // => true
all([2, 4, 6], fn x => x % 2 == 0) // => true

let x = 10
{
    let x = 20
    x // => 20
}
x // => 10
